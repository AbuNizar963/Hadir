{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hadir-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://abunizar963.github.io"
  },
  "account_id": "7c2f371786ada855f514d223e48daa72",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "Hadir",
      "database_id": "c9a96776-fcaa-4ae0-befa-b8c5a9345ebe",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "hadir-profile-images"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "HadirRealtime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime",
      "new_sqlite_classes": ["HadirRealtime"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
